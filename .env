# LangSmith
LANGSMITH_TRACING="true" # 是否启用LangSmith监控功能
LANGSMITH_TRACING_V2="true" # langsmith SDK 实际检查此变量（而非 LANGSMITH_TRACING）
# 前端（浏览器）通过 vue.config.js 代理 /langsmith → api.smith.langchain.com 解决公司网络限制
# Python 后端直接使用下方真实地址（server.js spawn 子进程时注入）
LANGSMITH_ENDPOINT="https://api.smith.langchain.com" # 监控API地址（Python后端使用）
LANGSMITH_API_KEY="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" # API_KEY
LANGSMITH_PROJECT="ai-agent" # 自定义项目名称，可以再LangSmith WebUI监控页面根据名称查看对应的运行记录
# 前端代理地址（DefinePlugin 注入 process.env 时使用此值，指向本地 devServer 代理）
LANGSMITH_ENDPOINT_FRONTEND="/langsmith"

